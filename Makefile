####### Compile

Algorithm.o: Algorithm.cpp Algorithm.h \
		config.h \
		Terrain.h \
		Brick.h \
		OurTank.h \
		Bullet.h \
		brick.h \
		EnemyTank.h \
		Base.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Algorithm.o Algorithm.cpp

base.o: base.cpp base.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o base.o base.cpp

brick.o: brick.cpp Brick.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o brick.o brick.cpp

Bullet.o: Bullet.cpp config.h \
		Bullet.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Bullet.o Bullet.cpp

enemytank.o: enemytank.cpp EnemyTank.h \
		Bullet.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o enemytank.o enemytank.cpp

main.o: main.cpp config.h \
		mainwindow.h \
		Algorithm.h \
		Terrain.h \
		Brick.h \
		OurTank.h \
		Bullet.h \
		brick.h \
		EnemyTank.h \
		Base.h \
		tipwindow.h \
		you_pass_the_game.h \
		you_lose.h \
		map_editor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		config.h \
		Algorithm.h \
		Terrain.h \
		Brick.h \
		OurTank.h \
		Bullet.h \
		brick.h \
		EnemyTank.h \
		Base.h \
		tipwindow.h \
		you_pass_the_game.h \
		you_lose.h \
		map_editor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

map_editor.o: map_editor.cpp map_editor.h \
		brick.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o map_editor.o map_editor.cpp

OurTank.o: OurTank.cpp OurTank.h \
		Bullet.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o OurTank.o OurTank.cpp

terrain.o: terrain.cpp terrain.h \
		Brick.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o terrain.o terrain.cpp

tipwindow.o: tipwindow.cpp tipwindow.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o tipwindow.o tipwindow.cpp

you_lose.o: you_lose.cpp you_lose.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o you_lose.o you_lose.cpp

you_pass_the_game.o: you_pass_the_game.cpp you_pass_the_game.h \
		config.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o you_pass_the_game.o you_pass_the_game.cpp

moc_Bullet.o: moc_Bullet.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_Bullet.o moc_Bullet.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_tipwindow.o: moc_tipwindow.cpp 
